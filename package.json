{
  "name": "ramme",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Anders Hessellund Jensen",
  "description": "One tree for JavaScript services and work: dependency injection, structured concurrency and resource lifetimes, with generator bodies the runtime steps and interrupts. Zero dependencies; Node 22+ or an evergreen browser.",
  "keywords": [
    "dependency injection",
    "di",
    "structured concurrency",
    "tasks",
    "fibers",
    "cancellation",
    "generators",
    "resource management",
    "lifetime",
    "scopes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andershessellund/ramme.git"
  },
  "bugs": "https://github.com/andershessellund/ramme/issues",
  "homepage": "https://github.com/andershessellund/ramme#readme",
  "sideEffects": [
    "./dist/disposal-symbols.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "default": "./dist/result.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test",
    "NOTICE",
    "DESIGN.md",
    "DECISIONS.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.tests.json",
    "check:package": "publint --strict && attw --pack . --profile esm-only && pnpm check:surface",
    "check:surface": "tsc -p scripts/tsconfig.surface.json && node scripts/check-surface.mjs",
    "check:plugin": "pnpm -C packages/eslint-plugin-ramme run check",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
