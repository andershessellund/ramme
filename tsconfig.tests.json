{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2024", "ESNext.Disposable", "DOM"],
    "rootDir": ".",
    // tests/contracts/surface.check.ts imports the package by name: here that is the source surface;
    // scripts/tsconfig.surface.json compiles the same probe against dist/index.d.ts.
    "paths": {
      "ramme": ["./src/index.ts"],
      "ramme/result": ["./src/result.ts"],
      "ramme/platform": ["./src/platform.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": []
}
