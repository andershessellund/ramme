{
  "name": "eslint-plugin-ramme",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Anders Hessellund Jensen",
  "description": "ESLint rules for ramme's generator bodies: an async function where a body is expected, a work op made and never yielded, a discarded outcome, a bare timer, the wiring errors syntax can see, and the platform's bare listeners, fetch and for await that ramme/platform replaces.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "ramme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andershessellund/ramme.git",
    "directory": "packages/eslint-plugin-ramme"
  },
  "bugs": "https://github.com/andershessellund/ramme/issues",
  "homepage": "https://github.com/andershessellund/ramme/tree/main/packages/eslint-plugin-ramme#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "clean": "rm -rf dist",
    "prepack": "pnpm clean && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
